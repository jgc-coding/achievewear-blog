---
// Artikelseite im Stil der Vorlage: der Artikel steht als weißes Blatt auf der
// Seite — Kategorie, Titel, kurze Linie, Meta-Zeile, Titelbild, Text, Signatur,
// Schlagwörter. Darunter der Über-mich-Kasten und "Mehr aus …".
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostKarte from '../../components/PostKarte.astro';
import SektionsTitel from '../../components/SektionsTitel.astro';
import UeberMichKasten from '../../components/UeberMichKasten.astro';
import { getKategorien, getSiteSettings } from '../../lib/settings';
import { withBase } from '../../lib/url';
import { formatDatum, isoDatum } from '../../lib/format';
import { teilenBildUrl } from '../../lib/teilen';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);

const site = await getSiteSettings();
const kategorien = await getKategorien();
const kategorie = kategorien.find((k) => k.slug === post.data.category);

const verwandte = (
  await getCollection(
    'blog',
    ({ data, id }) => !data.draft && data.category === post.data.category && id !== post.id
  )
)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

// Teilen-Bild aus dem Titelbild des Artikels (1200×630, JPEG — siehe lib/teilen.ts)
const ogImageUrl = await teilenBildUrl(post.data.cover, Astro.site);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={ogImageUrl}
  ogType="article"
>
  {/* Pagefind indexiert NUR Elemente mit data-pagefind-body — so landen genau die
      Artikeltexte im Suchindex, nicht Impressum, Datenschutz & Co. */}
  <article class="container artikel" data-pagefind-body>
    <div class="artikel-blatt">
      <header class="artikel-kopf">
        {
          kategorie && (
            <a class="kicker artikel-kategorie" href={withBase(`/kategorie/${kategorie.slug}`)}>
              {kategorie.name}
            </a>
          )
        }
        <h1 class="artikel-titel">{post.data.title}</h1>
        <span class="mini-linie" aria-hidden="true"></span>
        <p class="artikel-meta">
          <span>
            Veröffentlicht am{' '}
            <time datetime={isoDatum(post.data.date)}>{formatDatum(post.data.date)}</time>
          </span>
          <span class="punkt" aria-hidden="true">·</span>
          <span>{remarkPluginFrontmatter.lesezeit} Min. Lesezeit</span>
          {
            post.data.updated && (
              <>
                <span class="punkt" aria-hidden="true">·</span>
                <span>Aktualisiert am {formatDatum(post.data.updated)}</span>
              </>
            )
          }
        </p>
      </header>

      <div class="artikel-cover">
        <Image
          src={post.data.cover}
          alt={post.data.coverAlt}
          widths={[760, 1200]}
          sizes="(max-width: 900px) 100vw, 860px"
          loading="eager"
        />
      </div>

      <div class="prose artikel-text">
        <Content />
      </div>

      {
        post.data.signature && site.signatureText && (
          <div class="signatur">
            <span class="mini-linie mini-linie--mitte" aria-hidden="true"></span>
            <p>{site.signatureText}</p>
          </div>
        )
      }

      {
        post.data.tags.length > 0 && (
          <p class="tags">
            {post.data.tags.map((tag) => (
              <span class="tag">#{tag}</span>
            ))}
          </p>
        )
      }
    </div>

    <p class="zurueck">
      <a class="lesen-link" href={withBase('/blog')}><span aria-hidden="true">←</span> Alle Artikel</a>
    </p>
  </article>

  <div class="container artikel-breite">
    <UeberMichKasten />
  </div>

  {
    verwandte.length > 0 && kategorie && (
      <aside class="container verwandt" aria-label={`Mehr aus ${kategorie.name}`}>
        <SektionsTitel text={`Mehr aus ${kategorie.name}`} />
        <div class="verwandt-grid">
          {verwandte.map((eintrag) => (
            <PostKarte post={eintrag} kategorieName={kategorie.name} />
          ))}
        </div>
      </aside>
    )
  }
</BaseLayout>

<style>
  .artikel {
    max-width: 920px;
    padding-top: clamp(24px, 4vw, 56px);
  }

  /* Das weiße Blatt mit feiner Kante — wie die Artikelseiten der Vorlage */
  .artikel-blatt {
    --blatt-rand: clamp(22px, 5.5vw, 64px);
    background: var(--weiss);
    border: 1px solid var(--linie);
    box-shadow: var(--schatten-karte);
    padding: var(--blatt-rand);
  }

  .artikel-kopf {
    margin-bottom: clamp(24px, 3.5vw, 36px);
  }

  .artikel-kategorie {
    display: inline-block;
    color: var(--salbei-tief);
    text-decoration: none;
    margin-bottom: 14px;
  }

  .artikel-kategorie:hover {
    text-decoration: underline;
    text-decoration-color: var(--volt-tief);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .artikel-titel {
    font-size: clamp(32px, 5vw, 50px);
    line-height: 1.12;
    margin: 0;
  }

  .artikel-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0;
  }

  .punkt {
    color: var(--salbei);
  }

  /* Titelbild läuft bis an die Kanten des Blatts */
  .artikel-cover {
    margin: 0 calc(-1 * var(--blatt-rand)) clamp(30px, 4.5vw, 48px);
  }

  .artikel-cover :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .artikel-text {
    max-width: 68ch;
    margin-inline: auto;
  }

  .signatur {
    text-align: center;
    margin-top: clamp(36px, 5vw, 56px);
  }

  .signatur p {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(24px, 3vw, 30px);
    line-height: 1.3;
    color: var(--salbei-tief);
    margin: 0;
  }

  .tags {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin: 24px 0 0;
  }

  /* Bewusst keine Knopf-Optik — Schlagwörter sind (noch) keine Links. */
  .tag {
    font-size: 14px;
    color: var(--text-muted);
  }

  .zurueck {
    text-align: center;
    margin: clamp(32px, 5vw, 48px) 0 0;
  }

  .artikel-breite {
    max-width: 920px;
  }

  .verwandt {
    margin-top: var(--abstand-sektion);
    max-width: 920px;
  }

  .verwandt-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 36px);
  }

  @media (max-width: 620px) {
    .verwandt-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
