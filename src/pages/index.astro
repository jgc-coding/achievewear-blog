---
// Startseite im Stil von Lisas Vorlage (luftig, redaktionell, große Bilder):
// Titelbild mit Schriftzug · Willkommen · Neu im Blog (neuester Artikel groß) ·
// Themen (drei runde Bilder auf schrägem Creme-Band) · Aus dem Blog (weitere
// Artikel, am Handy zum Wischen) · Über mich · Zitat · Newsletter.
// Texte und Bilder kommen aus einstellungen/startseite.yml (im CMS änderbar),
// die Artikel automatisch aus dem Blog.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SektionsTitel from '../components/SektionsTitel.astro';
import PostKarte from '../components/PostKarte.astro';
import { getStartseite, getKategorien, getSiteSettings } from '../lib/settings';
import { withBase, linkUrl } from '../lib/url';

const start = await getStartseite();
const kategorien = await getKategorien();
const site = await getSiteSettings();
const kategorieName = (slug: string) => kategorien.find((k) => k.slug === slug)?.name ?? slug;

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
// Der neueste Artikel steht groß oben, die nächsten drei als Karten weiter unten —
// so erscheint kein Artikel doppelt.
const [neuester, ...aeltere] = posts;
const blogKarten = aeltere.slice(0, 3);

const newsletterZiel = site.newsletterUrl || withBase('/newsletter');
// Externer Anmeldelink öffnet im neuen Tab — wie auf der Newsletter-Seite.
const newsletterExtern = Boolean(site.newsletterUrl);
---

<BaseLayout>
  <!-- ===== Titelbild ===== -->
  <section class="hero">
    <Image
      class="hero-bild"
      src={start.welcome.image}
      alt={start.welcome.imageAlt}
      widths={[640, 960, 1280, 1536]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-inhalt">
      <div class="hero-mitte">
        <h1 class="hero-titel">{site.title}</h1>
        <p class="hero-unterzeile">{site.tagline}</p>
      </div>
      {start.welcome.heroLine && <p class="hero-zeile">{start.welcome.heroLine}</p>}
    </div>
  </section>

  <!-- ===== Willkommen ===== -->
  <section class="container container--schmal willkommen fade-up">
    <h2 class="willkommen-titel">
      {start.welcome.headline} <em>{start.welcome.scriptLine}</em>
    </h2>
    <p class="willkommen-text">{start.welcome.text}</p>
    <a class="btn" href={linkUrl(start.welcome.buttonUrl)}>{start.welcome.buttonText}</a>
  </section>

  <!-- ===== Neu im Blog: der neueste Artikel groß ===== -->
  {
    neuester && (
      <section class="container feature fade-up" aria-labelledby="feature-titel">
        <div class="feature-kopf">
          <p class="kicker">Neu im Blog</p>
          <h2 class="feature-titel" id="feature-titel">
            <a href={withBase(`/blog/${neuester.id}`)}>{neuester.data.title}</a>
          </h2>
          <p class="kursiv-zeile">aus {kategorieName(neuester.data.category)}</p>
        </div>
        <a class="feature-bild" href={withBase(`/blog/${neuester.id}`)} tabindex="-1" aria-hidden="true">
          <Image
            src={neuester.data.cover}
            alt=""
            widths={[640, 960, 1280]}
            sizes="(max-width: 900px) 92vw, 660px"
          />
        </a>
        <div class="feature-rest">
          <p class="feature-teaser">{neuester.data.description}</p>
          <a class="btn" href={withBase(`/blog/${neuester.id}`)}>
            Weiterlesen<span class="sr-only">: {neuester.data.title}</span>
          </a>
        </div>
      </section>
    )
  }

  <!-- ===== Themen: die drei Kategorien als runde Bilder ===== -->
  <section class="band band--creme band--schraeg themen">
    <div class="container">
      <div class="fade-up">
        <SektionsTitel text={start.themen.headline} zeile={start.themen.scriptLine} />
      </div>
      <ul class="themen-liste">
        {
          kategorien.map((kategorie, index) => (
            <li class="fade-up" style={`transition-delay:${index * 0.1}s`}>
              <a class="thema" href={withBase(`/kategorie/${kategorie.slug}`)}>
                <span class="thema-bild" style={`--thema-farbe:${kategorie.color}`}>
                  <Image
                    src={kategorie.image}
                    alt={kategorie.imageAlt}
                    widths={[320, 640]}
                    sizes="(max-width: 780px) 72vw, 300px"
                  />
                </span>
                <span class="thema-name">{kategorie.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ===== Aus dem Blog ===== -->
  {
    blogKarten.length > 0 && (
      <section class="blog-vorschau">
        <div class="container">
          <div class="fade-up">
            <SektionsTitel text={start.blogSection.headline} zeile={start.blogSection.scriptLine} />
          </div>
          <div class="karten-reihe" style={`--anzahl:${blogKarten.length}`}>
            {blogKarten.map((post) => (
              <PostKarte post={post} kategorieName={kategorieName(post.data.category)} />
            ))}
          </div>
          <p class="alle-artikel">
            <a class="btn" href={withBase('/blog')}>Alle Artikel</a>
          </p>
        </div>
      </section>
    )
  }

  <!-- ===== Über mich ===== -->
  <section class="ueber">
    <div class="ueber-bild">
      <Image
        src={start.about.image}
        alt={start.about.imageAlt}
        widths={[640, 960, 1280]}
        sizes="(max-width: 900px) 100vw, 50vw"
      />
    </div>
    <div class="ueber-text fade-up">
      <h2 class="ueber-titel">{start.about.headline}</h2>
      <p class="kursiv-zeile">{start.about.scriptLine}</p>
      <span class="mini-linie" aria-hidden="true"></span>
      <p class="ueber-copy">{start.about.text}</p>
      <a class="btn" href={linkUrl(start.about.buttonUrl)}>{start.about.buttonText}</a>
    </div>
  </section>

  <!-- ===== Zitat ===== -->
  <section class="container container--schmal zitat fade-up">
    <span class="zitat-zeichen" aria-hidden="true">&ldquo;</span>
    <blockquote>
      <p class="zitat-text">{start.quote.text}</p>
      <span class="mini-linie mini-linie--mitte" aria-hidden="true"></span>
      <cite class="zitat-von">{start.quote.attribution}</cite>
    </blockquote>
  </section>

  <!-- ===== Newsletter ===== -->
  {
    start.newsletter.show && (
      <section class="band band--mint newsletter">
        <div class="container container--schmal newsletter-inhalt fade-up">
          <h2 class="newsletter-titel">{start.newsletter.headline}</h2>
          <p class="newsletter-text">{start.newsletter.text}</p>
          <a
            class="btn btn--dunkel"
            href={newsletterZiel}
            target={newsletterExtern ? '_blank' : undefined}
            rel={newsletterExtern ? 'noopener noreferrer' : undefined}
          >
            {start.newsletter.buttonText}
          </a>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* ---------- Titelbild ---------- */
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    height: clamp(520px, 78vh, 760px);
    overflow: hidden;
    background: var(--creme);
  }

  .hero :global(.hero-bild) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Weicher heller Schleier in der Mitte, damit der Schriftzug auf jedem
     Foto lesbar bleibt */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 55% 45% at 50% 50%,
      rgba(247, 241, 237, 0.72) 0%,
      rgba(247, 241, 237, 0.35) 55%,
      rgba(247, 241, 237, 0) 100%
    );
    pointer-events: none;
  }

  .hero-inhalt {
    position: relative;
    z-index: 1;
    text-align: center;
    padding-inline: 20px;
  }

  .hero-titel {
    font-size: clamp(50px, 9vw, 96px);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1;
    margin: 0;
  }

  .hero-unterzeile {
    font-family: var(--font-serif);
    font-size: clamp(22px, 2.8vw, 30px);
    margin: 10px 0 0;
  }

  /* Kursive Zeile mit Strich links (wie die Vorlage). Am Desktop direkt unter
     dem Schriftzug in der ruhigen Bildmitte — am Rand läge sie auf Gegenständen
     im Foto. Am Handy unten links (siehe Media Query). */
  .hero-zeile {
    display: inline-block;
    margin: 30px 0 0;
    padding-left: 16px;
    border-left: 2px solid var(--anthrazit);
    text-align: left;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(20px, 2.2vw, 24px);
    line-height: 1.3;
  }

  /* ---------- Willkommen ---------- */
  .willkommen {
    text-align: center;
    padding-block: var(--abstand-sektion);
  }

  .willkommen-titel {
    font-size: clamp(32px, 4.6vw, 48px);
    margin-bottom: 22px;
  }

  .willkommen-titel em {
    font-style: italic;
    color: var(--salbei-tief);
  }

  .willkommen-text {
    margin-bottom: 30px;
  }

  /* ---------- Neu im Blog ---------- */
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-areas:
      'kopf bild'
      'rest bild';
    margin-bottom: var(--abstand-sektion);
  }

  .feature-kopf,
  .feature-rest {
    background: var(--creme);
    padding-inline: clamp(28px, 4vw, 56px);
  }

  /* Beide Zellen strecken sich, damit das Creme-Feld als Ganzes durchläuft;
     der Kopf sitzt unten an der Naht, der Rest oben. */
  .feature-kopf {
    grid-area: kopf;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: clamp(36px, 5vw, 64px);
  }

  .feature-rest {
    grid-area: rest;
    padding-bottom: clamp(36px, 5vw, 64px);
  }

  .feature-titel {
    font-size: clamp(32px, 3.6vw, 42px);
    margin: 0 0 8px;
  }

  .feature-titel a {
    color: var(--salbei-tief);
    text-decoration: none;
  }

  .feature-titel a:hover {
    text-decoration: underline;
    text-decoration-color: var(--volt-tief);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .feature-bild {
    grid-area: bild;
    display: block;
  }

  .feature-bild :global(img) {
    width: 100%;
    height: 100%;
    min-height: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .feature-teaser {
    margin: 18px 0 26px;
  }

  /* ---------- Themen ---------- */
  .themen-liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 56px);
  }

  .thema {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    text-decoration: none;
  }

  .thema-bild {
    display: block;
    width: 100%;
    max-width: 300px;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: var(--thema-farbe, var(--mint));
  }

  .thema-bild :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .thema:hover .thema-bild :global(img) {
    transform: scale(1.04);
  }

  /* Umrandetes Etikett wie "Hosen" in der Vorlage */
  .thema-name {
    font-size: 15px;
    font-weight: 600;
    color: var(--anthrazit);
    border: 2px solid var(--anthrazit);
    padding: 6px 16px;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .thema:hover .thema-name {
    background: var(--anthrazit);
    color: var(--volt);
  }

  /* ---------- Aus dem Blog ---------- */
  .blog-vorschau {
    padding-block: var(--abstand-sektion);
  }

  .karten-reihe {
    display: grid;
    grid-template-columns: repeat(var(--anzahl), minmax(0, 1fr));
    gap: clamp(24px, 3vw, 36px);
    max-width: calc(var(--anzahl) * 400px);
    margin-inline: auto;
  }

  .alle-artikel {
    text-align: center;
    margin: clamp(36px, 5vw, 52px) 0 0;
  }

  /* ---------- Über mich ---------- */
  .ueber {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    background: var(--creme);
  }

  .ueber-bild :global(img) {
    width: 100%;
    height: 100%;
    min-height: 420px;
    object-fit: cover;
  }

  .ueber-text {
    align-self: center;
    padding: clamp(40px, 6vw, 88px) clamp(24px, 6vw, 88px);
    max-width: 620px;
  }

  .ueber-titel {
    font-size: clamp(30px, 3.6vw, 40px);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .ueber-copy {
    margin-bottom: 28px;
  }

  /* ---------- Zitat ---------- */
  .zitat {
    position: relative;
    text-align: center;
    padding-block: var(--abstand-sektion);
  }

  .zitat-zeichen {
    display: block;
    font-family: var(--font-serif);
    font-size: 96px;
    line-height: 0.6;
    height: 40px;
    color: var(--salbei);
  }

  .zitat blockquote {
    margin: 0;
  }

  .zitat-text {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(26px, 3.4vw, 36px);
    line-height: 1.35;
    margin: 0;
  }

  .zitat-von {
    font-style: normal;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ---------- Newsletter ---------- */
  .newsletter {
    margin-bottom: calc(-1 * var(--abstand-sektion));
  }

  .newsletter-inhalt {
    text-align: center;
  }

  .newsletter-titel {
    font-size: clamp(34px, 4.6vw, 48px);
    margin-bottom: 14px;
  }

  .newsletter-text {
    margin-bottom: 28px;
  }

  /* ---------- Handy & Tablet ---------- */
  @media (max-width: 900px) {
    .feature {
      grid-template-columns: 1fr;
      grid-template-areas:
        'kopf'
        'bild'
        'rest';
      text-align: center;
    }

    .feature-kopf,
    .feature-rest {
      background: none;
      padding-inline: 0;
    }

    .feature-kopf {
      padding-top: 0;
      padding-bottom: 24px;
    }

    .feature-rest {
      padding-bottom: 0;
    }

    .feature-bild :global(img) {
      aspect-ratio: 4 / 3;
      height: auto;
    }

    .ueber {
      grid-template-columns: 1fr;
    }

    .ueber-bild :global(img) {
      min-height: 0;
      aspect-ratio: 3 / 2;
    }

    .ueber-text {
      text-align: center;
      max-width: none;
    }

    .ueber-text .mini-linie {
      margin-inline: auto;
    }

    /* Artikel-Karten am Handy zum Wischen, die nächste schaut ein Stück herein */
    .karten-reihe {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(84%, 380px);
      max-width: none;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: calc(-1 * clamp(18px, 4vw, 40px));
      padding: 4px clamp(18px, 4vw, 40px) 18px;
      scroll-padding-inline: clamp(18px, 4vw, 40px);
      scrollbar-width: none;
    }

    .karten-reihe::-webkit-scrollbar {
      display: none;
    }

    .karten-reihe > :global(*) {
      scroll-snap-align: start;
    }
  }

  @media (max-width: 780px) {
    .hero {
      height: clamp(480px, 76svh, 680px);
    }

    /* Drei Zeilen: oben Luft, Mitte Schriftzug, unten die kursive Zeile */
    .hero-inhalt {
      align-self: stretch;
      justify-self: stretch;
      display: grid;
      grid-template-rows: 1fr auto 1fr;
      padding-inline: 20px;
    }

    .hero-mitte {
      grid-row: 2;
    }

    .hero-zeile {
      grid-row: 3;
      align-self: end;
      justify-self: start;
      max-width: 26ch;
      margin: 0 0 clamp(28px, 6vh, 48px);
    }

    .themen-liste {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 48px;
    }

    .thema-bild {
      width: min(72vw, 300px);
    }
  }
</style>
