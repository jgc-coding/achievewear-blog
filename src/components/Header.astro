---
// Kopfzeile im Stil der Vorlage:
// - Handy: Menü-Knopf links, Logo in der Mitte, Lupe rechts; das Menü klappt
//   unter der Kopfzeile auf.
// - Desktop: Menü links und rechts vom Logo, Lupe ganz rechts.
// Logo = Lisas CI: "Achieve" in Cormorant Garamond + "wear" in Great Vibes.
// Alle Texte und Menüpunkte kommen aus den Website-Einstellungen im CMS.
import { getSiteSettings } from '../lib/settings';
import { withBase, linkUrl } from '../lib/url';

const site = await getSiteSettings();
const alleMenuepunkte = [...site.navLeft, ...site.navRight];
---

<header class="kopf">
  <div class="container kopf-raster">
    <button
      class="menue-knopf"
      type="button"
      aria-expanded="false"
      aria-controls="mobil-menue"
      aria-label="Menü öffnen"
      data-menue-knopf
    >
      <span class="menue-striche" aria-hidden="true"></span>
    </button>

    <nav class="nav nav-links" aria-label="Hauptnavigation links">
      {site.navLeft.map((eintrag) => <a href={linkUrl(eintrag.url)}>{eintrag.label}</a>)}
    </nav>

    <a class="logo" href={withBase('/')} aria-label={`${site.title} — Startseite`}>
      <span class="logo-lockup" aria-hidden="true">
        <span class="logo-serif">{site.logoSerif}</span>
        <span class="logo-script">{site.logoScript}</span>
      </span>
      <span class="logo-subline" aria-hidden="true">{site.tagline}</span>
    </a>

    <nav class="nav nav-rechts" aria-label="Hauptnavigation rechts">
      {site.navRight.map((eintrag) => <a href={linkUrl(eintrag.url)}>{eintrag.label}</a>)}
    </nav>

    <a class="such-knopf" href={withBase('/suche')} aria-label="Suche">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"
        ></circle>
        <path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
        ></path>
      </svg>
    </a>
  </div>

  <nav id="mobil-menue" class="mobil-menue" aria-label="Menü">
    <ul>
      {
        alleMenuepunkte.map((eintrag) => (
          <li>
            <a href={linkUrl(eintrag.url)}>{eintrag.label}</a>
          </li>
        ))
      }
      <li><a href={withBase('/suche')}>Suche</a></li>
    </ul>
  </nav>
</header>

<script>
  // Menü am Handy auf- und zuklappen. Ohne JavaScript zeigt CSS die Liste
  // einfach dauerhaft unter der Kopfzeile (siehe html:not(.js) unten).
  const knopf = document.querySelector<HTMLButtonElement>('[data-menue-knopf]');
  const menue = document.getElementById('mobil-menue');

  if (knopf && menue) {
    const setzen = (offen: boolean) => {
      knopf.setAttribute('aria-expanded', String(offen));
      knopf.setAttribute('aria-label', offen ? 'Menü schließen' : 'Menü öffnen');
      menue.classList.toggle('offen', offen);
    };

    knopf.addEventListener('click', () => {
      setzen(knopf.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (ereignis) => {
      if (ereignis.key === 'Escape' && menue.classList.contains('offen')) {
        setzen(false);
        knopf.focus();
      }
    });

    document.addEventListener('click', (ereignis) => {
      const ziel = ereignis.target as Node;
      if (menue.classList.contains('offen') && !menue.contains(ziel) && !knopf.contains(ziel)) {
        setzen(false);
      }
    });
  }
</script>

<style>
  .kopf {
    position: relative;
    z-index: 20;
    background: var(--weiss);
    border-bottom: 1px solid var(--linie);
  }

  .kopf-raster {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(16px, 3vw, 40px);
    padding-block: 26px 22px;
  }

  .nav {
    display: flex;
    gap: clamp(18px, 2.6vw, 36px);
    flex-wrap: wrap;
  }

  .nav-links {
    justify-content: flex-end;
  }

  .nav-rechts {
    justify-content: flex-start;
  }

  .nav a {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--anthrazit);
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
    transition: border-color 0.2s ease;
    white-space: nowrap;
  }

  .nav a:hover {
    border-bottom-color: var(--volt-tief);
  }

  /* ---------- Logo ---------- */

  .logo {
    grid-column: 2;
    text-align: center;
    text-decoration: none;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-self: center;
  }

  .logo-lockup {
    position: relative;
    display: inline-block;
    padding-right: 0.55em;
  }

  .logo-serif {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(27px, 4vw, 38px);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--anthrazit);
    line-height: 1;
  }

  .logo-script {
    position: absolute;
    right: -0.4em;
    bottom: -0.45em;
    font-family: var(--font-logo-script);
    font-size: clamp(24px, 3.4vw, 32px);
    color: var(--salbei);
    transform: rotate(-5deg);
    line-height: 1;
  }

  .logo-subline {
    margin-top: 14px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ---------- Handy-Bedienelemente (am Desktop ausgeblendet) ---------- */

  .menue-knopf,
  .such-knopf {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    background: none;
    border: 0;
    padding: 0;
    color: var(--anthrazit);
    cursor: pointer;
  }

  .menue-striche,
  .menue-striche::before,
  .menue-striche::after {
    display: block;
    width: 22px;
    height: 2px;
    background: currentColor;
    transition: transform 0.25s ease, background 0.25s ease;
  }

  .menue-striche {
    position: relative;
  }

  .menue-striche::before,
  .menue-striche::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .menue-striche::before {
    top: -7px;
  }

  .menue-striche::after {
    top: 7px;
  }

  /* Offen: aus den drei Strichen wird ein X */
  .menue-knopf[aria-expanded='true'] .menue-striche {
    background: transparent;
  }

  .menue-knopf[aria-expanded='true'] .menue-striche::before {
    transform: translateY(7px) rotate(45deg);
  }

  .menue-knopf[aria-expanded='true'] .menue-striche::after {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobil-menue {
    display: none;
  }

  /* Am Desktop steht die Lupe rechts neben dem Menü */
  @media (min-width: 901px) {
    .such-knopf {
      display: inline-flex;
      position: absolute;
      right: clamp(18px, 4vw, 40px);
      top: 50%;
      transform: translateY(-50%);
    }

    .kopf-raster {
      position: relative;
    }
  }

  @media (max-width: 900px) {
    .kopf-raster {
      grid-template-columns: 44px 1fr 44px;
      gap: 8px;
      padding-block: 18px 16px;
    }

    .nav {
      display: none;
    }

    .menue-knopf,
    .such-knopf {
      display: inline-flex;
    }

    .menue-knopf {
      grid-column: 1;
      grid-row: 1;
    }

    .logo {
      grid-row: 1;
    }

    .such-knopf {
      grid-column: 3;
      grid-row: 1;
      justify-self: end;
    }

    .logo-subline {
      margin-top: 12px;
      font-size: 10px;
    }

    .mobil-menue {
      display: block;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--weiss);
      border-bottom: 1px solid var(--linie);
      box-shadow: 0 18px 30px rgba(58, 58, 58, 0.08);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity 0.22s ease, transform 0.22s ease, visibility 0s linear 0.22s;
    }

    .mobil-menue.offen {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition: opacity 0.22s ease, transform 0.22s ease, visibility 0s;
    }

    .mobil-menue ul {
      list-style: none;
      margin: 0;
      padding: 10px 0 22px;
      text-align: center;
    }

    .mobil-menue a {
      display: block;
      padding: 10px 20px;
      font-family: var(--font-serif);
      font-size: 26px;
      font-weight: 500;
      color: var(--anthrazit);
      text-decoration: none;
    }

    .mobil-menue a:hover {
      color: var(--salbei-tief);
    }

    /* Ohne JavaScript: kein Menü-Knopf, die Liste steht offen da */
    :global(html:not(.js)) .menue-knopf {
      visibility: hidden;
    }

    :global(html:not(.js)) .mobil-menue {
      position: static;
      visibility: visible;
      opacity: 1;
      transform: none;
      box-shadow: none;
    }
  }
</style>
