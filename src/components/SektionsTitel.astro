---
// Abschnitts-Überschrift im Stil der Vorlage: schlanke Serife, darunter
// optional eine kursive Begleitzeile; darüber optional eine kleine
// Versalien-Zeile ("kicker"). Ersetzt die frühere Schreibschrift-Zeile.
interface Props {
  text: string;
  zeile?: string;
  kicker?: string;
  align?: 'center' | 'left';
  /** Seiten ohne eigenes h1 (z. B. Blog-Übersicht) setzen hier 'h1'. */
  ebene?: 'h1' | 'h2';
}

const { text, zeile, kicker, align = 'center', ebene = 'h2' } = Astro.props;
const Tag = ebene;
---

<div class={`sektions-titel align-${align}`}>
  {kicker && <p class="kicker">{kicker}</p>}
  <Tag class="titel">{text}</Tag>
  {zeile && <p class="kursiv-zeile zeile">{zeile}</p>}
</div>

<style>
  .sektions-titel {
    margin-bottom: clamp(30px, 4.5vw, 48px);
    text-align: center;
  }

  .align-left {
    text-align: left;
  }

  .titel {
    font-size: clamp(32px, 4.4vw, 46px);
    font-weight: 500;
    color: var(--salbei-tief);
    letter-spacing: 0.01em;
    margin: 0;
    white-space: pre-line;
  }

  .zeile {
    margin-top: 8px;
  }
</style>
