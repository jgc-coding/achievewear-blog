---
// Fußzeile im Stil der Vorlage: Spalten "Rechtliches" und "Links", darunter
// Copyright-Zeile aus den Einstellungen und die Versionsnummer
// (Single Source: package.json). Die Menüpunkte kommen aus den
// Website-Einstellungen — so gibt es keine zweite, abweichende Liste.
import { getSiteSettings } from '../lib/settings';
import { withBase, linkUrl } from '../lib/url';
import pkg from '../../package.json';

const site = await getSiteSettings();
const jahr = new Date().getFullYear();
const footerText = site.footerText.replaceAll('{jahr}', String(jahr));
const menue = [...site.navLeft, ...site.navRight];
---

<footer class="fuss">
  <div class="container fuss-raster">
    <div class="fuss-marke">
      <a class="fuss-logo" href={withBase('/')}>{site.title}</a>
      <p class="fuss-tagline">{site.tagline}</p>
    </div>

    <nav class="fuss-spalte" aria-label="Rechtliches">
      <p class="fuss-titel">Rechtliches</p>
      <ul>
        <li><a href={withBase('/impressum')}>Impressum</a></li>
        <li><a href={withBase('/datenschutz')}>Datenschutz</a></li>
      </ul>
    </nav>

    <nav class="fuss-spalte" aria-label="Links">
      <p class="fuss-titel">Links</p>
      <ul>
        {
          menue.map((eintrag) => (
            <li>
              <a href={linkUrl(eintrag.url)}>{eintrag.label}</a>
            </li>
          ))
        }
        <li><a href={withBase('/suche')}>Suche</a></li>
        <li><a href={withBase('/rss.xml')}>RSS-Feed</a></li>
        {
          site.pinterestUrl && (
            <li>
              <a href={site.pinterestUrl} target="_blank" rel="noopener noreferrer">
                Pinterest
              </a>
            </li>
          )
        }
      </ul>
    </nav>
  </div>

  <div class="container fuss-unten">
    <p class="fuss-text">{footerText}</p>
    <p class="fuss-version">Version {pkg.version}</p>
  </div>
</footer>

<style>
  .fuss {
    margin-top: var(--abstand-sektion);
    border-top: 1px solid var(--linie);
    background: var(--weiss);
  }

  .fuss-raster {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: clamp(28px, 5vw, 64px);
    padding-block: clamp(40px, 6vw, 64px) 28px;
  }

  .fuss-logo {
    font-family: var(--font-serif);
    font-size: 30px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--anthrazit);
    text-decoration: none;
  }

  .fuss-tagline {
    margin: 6px 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 20px;
    color: var(--text-muted);
  }

  .fuss-titel {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 14px;
  }

  .fuss-spalte ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .fuss-spalte li {
    margin-bottom: 8px;
  }

  .fuss-spalte a {
    font-size: 16px;
    color: var(--anthrazit);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: border-color 0.2s ease;
  }

  .fuss-spalte a:hover {
    border-bottom-color: var(--volt-tief);
  }

  .fuss-unten {
    padding-block: 18px 30px;
    border-top: 1px solid var(--linie);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 24px;
  }

  .fuss-text {
    font-size: 15px;
    color: var(--text-muted);
    margin: 0;
  }

  .fuss-version {
    font-size: 13px;
    color: var(--text-muted);
    margin: 0;
  }

  @media (max-width: 720px) {
    .fuss-raster {
      grid-template-columns: 1fr 1fr;
    }

    .fuss-marke {
      grid-column: 1 / -1;
    }
  }
</style>
